# Шаг 1: Импорт библиотек
import numpy as np
import matplotlib.pyplot as plt
from sklearn.datasets import make_blobs
from sklearn.cluster import Birch

# Шаг 2: Генерация данных
# Создаем синтетические данные
X, y = make_blobs(n_samples=1000, centers=3, cluster_std=0.60, random_state=0) #значения можно изменять

# Визуализация исходных данных
plt.scatter(X[:, 0], X[:, 1], s=10, c='blue', label="Исходные данные")
plt.title("Исходные данные")
plt.xlabel("Признак 1")
plt.ylabel("Признак 2")
plt.legend()
plt.show()

# Шаг 3: Применение BIRCH
# Создаем модель BIRCH
birch_model = Birch(threshold=0.5, n_clusters=4) #значения можно изменять

# Обучаем модель на данных
birch_model.fit(X)

# Получаем метки кластеров
labels = birch_model.predict(X)

# Визуализация результатов кластеризации
plt.scatter(X[:, 0], X[:, 1], c=labels, s=10, cmap='viridis', label="Кластеры")
plt.title("Кластеризация с использованием BIRCH")
plt.xlabel("Признак 1")
plt.ylabel("Признак 2")
plt.legend()
plt.show()
